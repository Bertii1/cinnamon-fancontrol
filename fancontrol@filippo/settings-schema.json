{
    "section-curve": {
        "type": "section",
        "description": "Curva della ventola"
    },
    "curve": {
        "type": "entry",
        "default": "Bilanciato",
        "description": "Curva attiva",
        "tooltip": "Nome di una curva (incorporata, o creata con l'editor in Strumenti → Editor curve), oppure una definizione inline tipo 50:0,70:50,90:100. Scrivi \"Fisso\" per una velocita' fissa. Curve incorporate: Silenzioso, Bilanciato, Prestazioni, Aggressivo, Silenzio estremo."
    },
    "fixedSpeed": {
        "type": "spinbutton",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Velocita' fissa (con curva \"Fisso\")"
    },

    "section-sensors": {
        "type": "section",
        "description": "Sensori di temperatura"
    },
    "sensors": {
        "type": "entry",
        "default": "coretemp,nvme",
        "description": "Sensori (nomi hwmon separati da virgola)",
        "tooltip": "Vuoto = tutti i sensori trovati. Qui esistono: coretemp (CPU), nvme (SSD), acpitz."
    },
    "sensorAlgorithm": {
        "type": "combobox",
        "default": "max",
        "description": "Come combinarli",
        "options": {
            "Massimo (piu' prudente)": "max",
            "Media": "average",
            "Minimo (piu' silenzioso)": "min"
        }
    },

    "section-response": {
        "type": "section",
        "description": "Reattivita'"
    },
    "hysteresis": {
        "type": "spinbutton",
        "default": 2,
        "min": 0,
        "max": 20,
        "step": 0.5,
        "units": "°C",
        "description": "Isteresi",
        "tooltip": "Differenza minima di temperatura perche' la curva venga rivalutata."
    },
    "responseTime": {
        "type": "spinbutton",
        "default": 5,
        "min": 0,
        "max": 120,
        "step": 1,
        "units": "s",
        "description": "Tempo di risposta"
    },
    "stepUp": {
        "type": "spinbutton",
        "default": 8,
        "min": 1,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Salita massima per aggiornamento"
    },
    "stepDown": {
        "type": "spinbutton",
        "default": 4,
        "min": 1,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Discesa massima per aggiornamento"
    },
    "minSpeed": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Velocita' minima"
    },
    "maxSpeed": {
        "type": "spinbutton",
        "default": 100,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Velocita' massima"
    },

    "section-safety": {
        "type": "section",
        "description": "Sicurezza"
    },
    "criticalTemp": {
        "type": "spinbutton",
        "default": 92,
        "min": 60,
        "max": 105,
        "step": 1,
        "units": "°C",
        "description": "Temperatura critica (100% immediato)"
    },
    "followPowerProfile": {
        "type": "switch",
        "default": false,
        "description": "Segui il profilo energetico",
        "tooltip": "Cambia curva automaticamente al cambio di profilo: performance → Prestazioni, balanced → Bilanciato, power-saver → Silenzioso."
    },

    "section-notify": {
        "type": "section",
        "description": "Notifiche"
    },
    "alertsEnabled": {
        "type": "switch",
        "default": true,
        "description": "Notifiche attive (interruttore generale)"
    },
    "notifyCritical": {
        "type": "switch",
        "default": true,
        "description": "Temperatura critica"
    },
    "notifyFanFail": {
        "type": "switch",
        "default": true,
        "description": "Ventola non risponde"
    },
    "notifySensorMissing": {
        "type": "switch",
        "default": true,
        "description": "Sensori non leggibili"
    },
    "notifyCurveChange": {
        "type": "switch",
        "default": false,
        "description": "Cambio curva automatico"
    },

    "section-misc": {
        "type": "section",
        "description": "Pannello e diagnostica"
    },
    "showTemperature": {
        "type": "switch",
        "default": true,
        "description": "Mostra la temperatura nell'etichetta"
    },
    "logToFile": {
        "type": "switch",
        "default": false,
        "description": "Registra lo storico su file (CSV)"
    }
}
